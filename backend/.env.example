APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://kepin:kepin@localhost:5432/kepin
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
